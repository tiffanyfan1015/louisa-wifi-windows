<Window x:Class="LouisaWifi.App.StorePickerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Louisa Wi-Fi · 選擇門市" Width="680" Height="540" MinWidth="530" MinHeight="440" WindowStartupLocation="CenterScreen" Background="#FAF8F5">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Louisa Wi-Fi" FontSize="26" FontWeight="SemiBold" Foreground="#704E36"/><TextBlock Margin="0,6,0,16" Text="選擇你所在的門市，連上一次後即可記住。"/></StackPanel>
    <TextBox x:Name="Search" Grid.Row="1" Padding="9" Margin="0,0,0,12" TextChanged="SearchChanged" AutomationProperties.Name="搜尋門市名稱或地址" ToolTip="輸入門市名稱、縣市或地址"/>
    <ListBox x:Name="StoreList" Grid.Row="2" DisplayMemberPath="Display" SelectionChanged="SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
    <StackPanel Grid.Row="3" Margin="0,14,0,0">
      <TextBlock Text="密碼候選（可直接選擇，或自動依序嘗試）"/>
      <ComboBox x:Name="Candidates" Margin="0,5,0,10" Padding="5"/>
      <TextBlock Text="或輸入店內張貼的密碼（8–63 個英數／符號字元）"/>
      <PasswordBox x:Name="Password" Margin="0,5,0,0" Padding="7" AutomationProperties.Name="店內 Wi-Fi 密碼"/>
      <TextBlock x:Name="Status" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#555555"/>
    </StackPanel>
    <CheckBox x:Name="Authorized" Grid.Row="4" Margin="0,12,0,0" Content="我已獲准使用所選門市的 Wi-Fi"/>
    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="取消本次嘗試" Padding="14,7" Margin="0,0,10,0" Click="CancelClicked"/>
      <Button x:Name="ConnectButton" Content="連線" Padding="24,7" Click="ConnectClicked" IsDefault="True"/>
    </StackPanel>
  </Grid>
</Window>
